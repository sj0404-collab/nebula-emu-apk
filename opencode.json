{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/mimo-v2.6-flash-free",
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow"
  },
  "provider": {
    "pollinations": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://text.pollinations.ai/openai",
        "apiKey": "pollinations"
      },
      "models": {
        "openai-fast": {
          "name": "Pollinations GPT-OSS 20B (free fallback)",
          "limit": {
            "context": 128000,
            "output": 8000
          }
        },
        "openai": {
          "name": "Pollinations openai alias (free fallback)",
          "limit": {
            "context": 128000,
            "output": 8000
          }
        }
      }
    }
  }
}
